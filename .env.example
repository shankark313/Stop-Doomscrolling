# Copy to .env and fill in your values.

# Anthropic API key for Claude (claude-sonnet-4-6)
ANTHROPIC_API_KEY=your_key_here

# Telegram bot credentials
# Create a bot with @BotFather to get the token; message the bot, then
# call https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Exa API key — powers web search per topic. Get a free key at https://exa.ai
EXA_API_KEY=your_exa_key_here

# Optional: Jina Reader API key (https://jina.ai). Used to fetch the Product Hunt
# AI topic page via r.jina.ai with higher rate limits / reliability. The app works
# without it (anonymous r.jina.ai), but a key helps if you hit rate limits.
JINA_API_KEY=your_jina_key_here
