# Copy to .env and fill in your values.

# Anthropic API key for Claude (claude-sonnet-4-6)
ANTHROPIC_API_KEY=your_key_here

# Telegram bot credentials
# Create a bot with @BotFather to get the token; message the bot, then
# call https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Exa API key — powers web search per topic. Get a free key at https://exa.ai
EXA_API_KEY=your_exa_key_here

# Supabase — persists user settings across Railway redeploys (Railway's disk is
# ephemeral, so config.json alone loses your settings on every deploy/restart).
# Create a free project at https://supabase.com, run supabase_schema.sql in the
# SQL editor, then copy Project URL and anon public key from Settings -> API.
# If unset, the app falls back to a local config.json (fine for local dev only).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: Jina Reader API key (https://jina.ai). Used to fetch the Product Hunt
# AI topic page via r.jina.ai with higher rate limits / reliability. The app works
# without it (anonymous r.jina.ai), but a key helps if you hit rate limits.
JINA_API_KEY=your_jina_key_here

# Serper (serper.dev) — Google search + Google News for the Content Radar lane.
# Reaches Google's index, so it covers reddit.com (which Exa can't crawl and
# which rate-limits direct access) and gives a real 24h freshness filter.
# Optional: radar.py logs a warning and skips those passes if unset.
# NOTE: briefing.py also reads Reddit through Serper. Reddit's own JSON API
# answers 403 to servers and its RSS feed 429s after ~2 subreddits, so without
# this key the Reddit section will be nearly empty in production.
SERPER_API_KEY=your_serper_key_here

# Optional: YouTube bot-check workarounds. YouTube serves "Sign in to confirm
# you're not a bot" to datacenter IPs (e.g. Railway), which makes yt-dlp return
# zero videos even though the same channels work fine from a laptop. Set either:
#   YTDLP_COOKIES_B64 — base64 of a Netscape-format cookies.txt exported from a
#                   logged-in YouTube session. Preferred for dashboards: the
#                   format is tab-separated and textareas mangle tabs.
#                   Generate with: base64 -i cookies.txt | tr -d '\n'
#   YTDLP_COOKIES — the same file as plain text (fine for local use)
#   YTDLP_PROXY   — an http(s)/socks proxy on a residential IP
YTDLP_COOKIES_B64=
YTDLP_COOKIES=
YTDLP_PROXY=
